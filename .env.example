# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Dispatcher authentication (replace all defaults outside local demo)
AUTH_BOOTSTRAP_USERNAME=dispatcher
AUTH_BOOTSTRAP_PASSWORD=transport
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_EXPIRE_MINUTES=480
AUTH_JWT_ALGORITHM=HS256
AUTH_COOKIE_NAME=transport_session
# true when the application is served over HTTPS
AUTH_COOKIE_SECURE=false
AUTH_DATABASE_CONNECT_TIMEOUT_S=3.0

# ML Service
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8001
ML_WORKERS=4
ML_SERVICE_URL=http://ml:8001
ML_REQUEST_TIMEOUT_S=5.0
ML_MAX_IN_FLIGHT=8
ARTIFACTS_DIR=artifacts
MODEL_NAME=lightgbm_plan
RELEASE_MODEL_NAME=lightgbm_plan
MODEL_VERSION=1.0
SCHEDULE_PLAN_PATH=data/raw/validate/schedule_plan.csv
MAE_TARGET=

# NDTP TCP server (emulator connects here)
NDTP_HOST=0.0.0.0
NDTP_PORT=9201
RUNTIME_SCHEDULE_PATH=data/raw/validate/schedule_plan.csv
RUNTIME_TRAFFIC_PATH=data/raw/validate/traffic.csv
RUNTIME_POINTS_PATH=
# Optional GeoJSON LineString/MultiLineString features with properties.tr_id.
RUNTIME_ROUTE_GRAPH_PATH=
SOURCE_TIMEZONE=Europe/Moscow
PREDICTION_INTERVAL_S=30
RISK_MEDIUM_DELAY_S=60
RISK_HIGH_DELAY_S=120
RISK_MEDIUM_PROBABILITY=0.25
RISK_HIGH_PROBABILITY=0.60
# Only for docker-compose.official-demo.yml: explicitly synthetic assumptions
# Five official demo units are configured in docker-compose.official-demo.yml.
DEMO_INITIAL_DELAY_S=1000
REPLAY_SCHEDULE_PATH=data/raw/test/schedule.csv
REPLAY_TRAFFIC_PATH=data/raw/test/traffic.csv
REPLAY_LABELS_PATH=data/raw/labels/labels_test.csv

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=transport
POSTGRES_USER=transport
POSTGRES_PASSWORD=transport

# Frontend (Vite + nginx)
FRONTEND_PORT=8080
FRONTEND_DEV_PORT=5173
VITE_APP_NAME=Сигнальная сетка
VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT_MS=5000
VITE_POLL_INTERVAL_MS=3000
VITE_MAP_STYLE_URL=
# только для pnpm dev вне docker
BACKEND_PROXY_TARGET=http://127.0.0.1:8000
