# Переменные VITE_* инлайнятся в бандл на этапе pnpm build / docker build.
VITE_APP_NAME=Диспетчерская · прогноз задержек
VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT_MS=5000
VITE_POLL_INTERVAL_MS=3000

# Локальный dev-сервер (pnpm dev)
FRONTEND_DEV_PORT=5173
FRONTEND_PREVIEW_PORT=4173
BACKEND_PROXY_TARGET=http://127.0.0.1:8000

# HMR при запуске vite внутри docker (проброс через порт хоста)
# VITE_HMR_HOST=localhost
# VITE_HMR_PORT=5173

# Порт nginx-контейнера (docker compose)
# FRONTEND_PORT=8080
