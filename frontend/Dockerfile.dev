FROM node:22-alpine

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    PNPM_STORE_DIR=/pnpm/store

RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml ./

RUN --mount=type=cache,id=frontend-pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --prefer-offline --store-dir "$PNPM_STORE_DIR"

COPY . .

EXPOSE 5173

# src монтируется volume'ом из compose, поэтому node_modules берётся из образа.
CMD ["pnpm", "dev", "--host", "0.0.0.0"]
